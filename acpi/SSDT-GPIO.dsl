// Enable the GPIO controller's pin interrupts under macOS so VoodooI2C
// can take the I2C trackpad, touchscreen, or pen if they use GPIO IRQs.
// GPEN / SBRG / GPHD are the names used by Skylake and Kaby Lake firmware.
// A name that does not exist is ignored. This is generic, not a dump of
// this machine's DSDT. If the trackpad stays dead, replace it with an
// SSDT generated by SSDTTime from your own DSDT.
DefinitionBlock ("", "SSDT", 2, "X360G2", "GPI0", 0x00001000)
{
    External (GPEN, FieldUnitObj)
    External (SBRG, FieldUnitObj)
    External (GPHD, FieldUnitObj)
    External (_SB_.PCI0.GPI0, DeviceObj)

    Scope (\_SB.PCI0.GPI0)
    {
        Method (_INI, 0, NotSerialized)
        {
            If (LNot (_OSI ("Darwin")))
            {
                Return
            }
            If (CondRefOf (GPEN))
            {
                GPEN = One
            }
            If (CondRefOf (SBRG))
            {
                SBRG = One
            }
            If (CondRefOf (GPHD))
            {
                GPHD = Zero
            }
        }
    }
}
